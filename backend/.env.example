# MongoDB (same connection string for both dev and prod, different databases)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=test

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Authentication (same value for all environments, stored in Repository Secrets)
JWT_SECRET=your-secret-key-here

# Server
PORT=4000
